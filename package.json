{
  "name": "2pdf.js",
  "version": "2.0.0",
  "description": "Convert Markdown and HTML files to PDF with styling, token replacement, and content processing features",
  "main": "src/index.js",
  "bin": {
    "2pdf": "./bin/2pdf.js"
  },
  "files": [
    "bin/",
    "src/",
    "public/assets/styles/pdf.min.css",
    "public/assets/images/logo-feral.png",
    "public/assets/images/logo-feral.svg",
    "public/assets/images/lockup-visa-cannonball.png",
    "public/assets/images/lockup-visa-cannonball.svg",
    "config/2pdf.config.sample"
  ],
  "scripts": {
    "start": "npm run web:css && (PORT=1646 node utils/open-when-ready.js & npx sass --watch --poll web/styles/app.scss:web/public/app.css --style=compressed & PORT=1646 node --watch web/server.js --dev)",
    "start:no-open": "OPEN_BROWSER=0 npm start",
    "web": "node web/server.js",
    "web:css": "npx sass web/styles/app.scss web/public/app.css --style=compressed",
    "build:css": "sass --no-source-map assets/styles/pdf.scss public/assets/styles/pdf.min.css --style=compressed",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/ bin/ web/ utils/",
    "lint:fix": "eslint src/ bin/ web/ utils/ --fix",
    "build": "npm run lint && npm test",
    "install-global": "npm install -g .",
    "dev": "nodemon src/index.js"
  },
  "keywords": [
    "markdown",
    "pdf",
    "converter",
    "pandoc",
    "chrome",
    "puppeteer",
    "documentation",
    "token-replacement",
    "styling"
  ],
  "author": "Ziad Ezzat <ziad@feralcreative.co>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/feralcreative/md-to-pdf.git"
  },
  "bugs": {
    "url": "https://github.com/feralcreative/md-to-pdf/issues"
  },
  "homepage": "https://github.com/feralcreative/md-to-pdf#readme",
  "engines": {
    "node": ">=14.0.0"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^11.0.0",
    "fs-extra": "^11.0.0",
    "glob": "^10.0.0",
    "marked": "^9.0.0",
    "marked-footnote": "^1.2.2",
    "path": "^0.12.7",
    "puppeteer": "^21.0.0",
    "which": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "nodemon": "^3.0.0",
    "sass": "^1.92.1"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/*.test.js"
    ]
  },
  "eslintConfig": {
    "env": {
      "node": true,
      "es2021": true,
      "jest": true
    },
    "extends": "eslint:recommended",
    "parserOptions": {
      "ecmaVersion": 12,
      "sourceType": "module"
    },
    "rules": {
      "no-console": "off",
      "no-unused-vars": [
        "error",
        {
          "argsIgnorePattern": "^_"
        }
      ]
    }
  }
}
